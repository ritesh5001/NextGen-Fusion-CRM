PORT=5050
NODE_ENV=production

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/crm_nextgenfusion

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS — client origin
CLIENT_ORIGIN=http://localhost:5173

# Initial superadmin (used by `npm run seed`)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@nextgenfusion.in
SUPERADMIN_PASSWORD=Admin@12345